# ==============================================================================
# AI Trading Agent — Backend Environment Configuration Template
# NOTE: Copy this file to .env and provide your individual API keys.
# NEVER commit your actual .env file with secrets into version control.
# ==============================================================================

# --- AI & LLM Provider ---
GEMINI_API_KEY=

# --- Market Data & News Providers ---
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=

# --- Broker / Execution (Paper Trading Only) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Telemetry & Observability (Optional) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=tradingagent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Application Runtime & Logging ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Trading Mode & Strict Safety Controls ---
# TRADING_MODE must be 'paper'. Any attempt to set 'live' is rejected by the application.
TRADING_MODE=paper
# TRADING_ENABLED controls whether order execution is permitted. Default: false.
TRADING_ENABLED=false
# ORDER_APPROVAL_REQUIRED enforces Human-in-the-Loop review before execution.
ORDER_APPROVAL_REQUIRED=true

# --- Risk Limits (USD) ---
MAX_ORDER_NOTIONAL_USD=100
MAX_POSITION_NOTIONAL_USD=500

# --- Allowed CORS Origins (Comma-separated, no wildcards) ---
CORS_ORIGINS=https://tradingagent-eight.vercel.app,http://localhost:3000,http://127.0.0.1:3000

